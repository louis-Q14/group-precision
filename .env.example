# Copier ce fichier en .env.local et remplir les valeurs
# (Supabase > Project Settings > API).
#
# Ces deux valeurs sont PUBLIQUES par conception : elles sont intégrées au site
# construit et visibles dans le navigateur. La sécurité repose sur les règles RLS
# de la base (supabase/migrations). Ne mettez JAMAIS ici la clé « service_role ».
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-publique-anon
