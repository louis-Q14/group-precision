{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "Contenu du t\u00e9moignage"
    },
    "author_name": {
      "type": "string",
      "description": "Nom de l'auteur"
    },
    "position": {
      "type": "string",
      "description": "Poste occup\u00e9"
    },
    "company": {
      "type": "string",
      "description": "Nom de l'entreprise"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 5,
      "description": "Note sur 5"
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "T\u00e9moignage approuv\u00e9 pour affichage"
    }
  },
  "required": [
    "content",
    "author_name"
  ]
}