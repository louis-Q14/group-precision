{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nom du projet"
    },
    "client": {
      "type": "string",
      "description": "Nom du client"
    },
    "description": {
      "type": "string",
      "description": "Description du projet"
    },
    "challenge": {
      "type": "string",
      "description": "D\u00e9fi \u00e0 relever"
    },
    "solution": {
      "type": "string",
      "description": "Solution apport\u00e9e"
    },
    "results": {
      "type": "string",
      "description": "R\u00e9sultats obtenus"
    },
    "image_url": {
      "type": "string",
      "description": "Image principale"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Galerie d'images"
    },
    "category": {
      "type": "string",
      "enum": [
        "web",
        "mobile",
        "branding",
        "marketing",
        "consulting"
      ],
      "description": "Cat\u00e9gorie"
    },
    "industry": {
      "type": "string",
      "enum": [
        "tech",
        "finance",
        "retail",
        "healthcare",
        "education",
        "other"
      ],
      "description": "Secteur d'activit\u00e9"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "description": "M\u00e9triques cl\u00e9s"
    },
    "testimonial": {
      "type": "string",
      "description": "T\u00e9moignage client"
    },
    "testimonial_author": {
      "type": "string",
      "description": "Auteur du t\u00e9moignage"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "year": {
      "type": "number"
    }
  },
  "required": [
    "title",
    "client"
  ]
}