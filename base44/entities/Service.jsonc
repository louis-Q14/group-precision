{
  "name": "Service",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nom du service"
    },
    "short_description": {
      "type": "string",
      "description": "Description courte"
    },
    "full_description": {
      "type": "string",
      "description": "Description d\u00e9taill\u00e9e"
    },
    "icon": {
      "type": "string",
      "description": "Nom de l'ic\u00f4ne Lucide"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des caract\u00e9ristiques"
    },
    "price_range": {
      "type": "string",
      "description": "Fourchette de prix"
    },
    "category": {
      "type": "string",
      "enum": [
        "consulting",
        "development",
        "marketing",
        "formation"
      ],
      "description": "Cat\u00e9gorie du service"
    },
    "order": {
      "type": "number",
      "description": "Ordre d'affichage"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "short_description"
  ]
}