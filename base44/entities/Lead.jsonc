{
  "name": "Lead",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nom complet du prospect"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Adresse email"
    },
    "phone": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone"
    },
    "company": {
      "type": "string",
      "description": "Nom de l'entreprise"
    },
    "position": {
      "type": "string",
      "description": "Poste occup\u00e9"
    },
    "message": {
      "type": "string",
      "description": "Message ou demande"
    },
    "source": {
      "type": "string",
      "enum": [
        "hero_form",
        "contact_page",
        "newsletter",
        "resource_download",
        "chat"
      ],
      "description": "Source de la capture"
    },
    "interest": {
      "type": "string",
      "enum": [
        "consulting",
        "development",
        "marketing",
        "formation",
        "autre"
      ],
      "description": "Domaine d'int\u00e9r\u00eat"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "proposal",
        "won",
        "lost"
      ],
      "default": "new",
      "description": "Statut du lead"
    },
    "budget_range": {
      "type": "string",
      "enum": [
        "< 5k",
        "5k-15k",
        "15k-50k",
        "50k-100k",
        "> 100k"
      ],
      "description": "Budget estim\u00e9"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "notes": {
      "type": "string",
      "description": "Notes internes"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}